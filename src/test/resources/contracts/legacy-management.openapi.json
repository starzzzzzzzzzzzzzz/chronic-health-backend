          "sourceHash": {
            "type": "string"
          },
          "diseases": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Disease"
            }
          },
          "medicationFacts": {
            "type": "string"
          },
          "decisionExplanation": {
            "$ref": "#/components/schemas/DecisionExplanation"
          }
        }
      },
      "Disease": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "risk": {
            "type": "string"
          },
          "subtype": {
            "type": "string"
          },
          "priority": {
            "type": "string"
          },
          "basis": {
            "type": "string"
          },
          "weights": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "format": "int32"
            }
          },
          "managementTypes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Option"
            }
          },
          "typeMatches": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Match"
            }
          },
          "secondarySubtypes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ruleVersion": {
            "type": "string"
          }
