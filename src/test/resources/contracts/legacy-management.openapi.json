      },
      "Option": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "condition": {
            "type": "string"
          },
          "initialWeights": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "format": "int32"
            }
          }
        }
      },
      "Match": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "missing": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Evidence"
            }
          }
        }
      },
      "Evidence": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          }
        }
      },
      "DecisionExplanation": {
        "type": "object",
        "properties": {
          "analysisBasis": {
            "type": "string"
          },
          "decisionSummary": {
            "type": "string"
          },
          "pendingConfirmation": {
            "type": "string"
          }
        }
      }
    }
  }
