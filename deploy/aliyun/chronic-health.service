[Unit]
Description=Chronic health development backend (SSH access only)
After=network-online.target mysql.service
Wants=network-online.target
Requires=mysql.service

[Service]
Type=simple
User=healthapp
Group=healthapp
WorkingDirectory=/opt/chronic-health
EnvironmentFile=/etc/chronic-health/backend.env
ExecStart=/usr/bin/java -Xms128m -Xmx384m -XX:MaxMetaspaceSize=192m -XX:MaxDirectMemorySize=64m -XX:+UseSerialGC -XX:+ExitOnOutOfMemoryError -Duser.timezone=Asia/Shanghai -jar /opt/chronic-health/app.jar
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
MemoryHigh=650M
MemoryMax=768M
MemorySwapMax=256M
TasksMax=128
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
